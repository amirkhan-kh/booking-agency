generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  AGENT
  FINANCE
  VIEWER
}

enum CompanyType {
  VENUE
  PROMOTER
  FESTIVAL
  BRAND
  AGENCY
  OTHER
}

enum TalentStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum BookingStatus {
  INQUIRY
  HOLD
  CONFIRMED
  CONTRACTED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS_CHANGE
  SYSTEM
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Tashkent")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  companies  Company[]
  contacts   Contact[]
  talent     Talent[]
  deals      Deal[]
  bookings   Booking[]
  invoices   Invoice[]
  activities Activity[]
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           Role      @default(AGENT)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  activities       Activity[] @relation("Actor")
  assignedDeals    Deal[]     @relation("DealOwner")
  assignedBookings Booking[]  @relation("BookingOwner")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Company {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           CompanyType @default(VENUE)
  city           String?
  country        String?
  website        String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  contacts Contact[]
  bookings Booking[]
  deals    Deal[]

  @@index([organizationId, deletedAt])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  firstName      String
  lastName       String
  email          String?
  phone          String?
  title          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  bookings   Booking[]
  deals      Deal[]
  activities Activity[]

  @@index([organizationId, deletedAt])
  @@index([companyId])
}

model Talent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  genre          String?
  homeCity       String?
  feeMin         Decimal?     @db.Decimal(12, 2)
  feeMax         Decimal?     @db.Decimal(12, 2)
  status         TalentStatus @default(ACTIVE)
  bio            String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  bookings Booking[]
  deals    Deal[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
}

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  stage          DealStage @default(LEAD)
  value          Decimal?  @db.Decimal(12, 2)
  expectedClose  DateTime?
  ownerId        String?
  owner          User?     @relation("DealOwner", fields: [ownerId], references: [id])
  talentId       String?
  talent         Talent?   @relation(fields: [talentId], references: [id])
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id])
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  booking Booking?

  @@index([organizationId, stage, deletedAt])
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  title          String
  status         BookingStatus @default(INQUIRY)
  eventDate      DateTime
  endDate        DateTime?
  venueName      String?
  city           String?
  fee            Decimal?      @db.Decimal(12, 2)
  deposit        Decimal?      @db.Decimal(12, 2)
  currency       String        @default("USD")
  talentId       String
  talent         Talent        @relation(fields: [talentId], references: [id])
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id])
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id])
  ownerId        String?
  owner          User?         @relation("BookingOwner", fields: [ownerId], references: [id])
  dealId         String?       @unique
  deal           Deal?         @relation(fields: [dealId], references: [id])
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  invoices   Invoice[]
  activities Activity[]

  @@index([organizationId, status, deletedAt])
  @@index([organizationId, eventDate])
  @@index([talentId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id])
  number         String
  status         InvoiceStatus @default(DRAFT)
  amount         Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("USD")
  issuedAt       DateTime?
  dueAt          DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           ActivityType @default(NOTE)
  body           String
  actorId        String?
  actor          User?        @relation("Actor", fields: [actorId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([contactId])
  @@index([bookingId])
}
