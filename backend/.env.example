# Local Docker: docker compose up -d
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking

# Production: faqat manzil/parolni o'zgartiring
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@SERVER_HOST:5432/DBNAME

SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Google Sheets (Instagram target) → Lidlar Kanban
# Apps Script X-Sheets-Secret bilan bir xil bo'lsin
SHEETS_WEBHOOK_SECRET=
# Apps Script Web App URL (CRM status → Sheet); bo'sh = faqat Sheet→CRM
SHEETS_CALLBACK_URL=
