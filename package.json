{
  "name": "booking-agency",
  "private": true,
  "version": "0.1.0",
  "description": "Travel booking agency CRM",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "backend": "cd backend && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "engines": {
    "node": "24.x"
  }
}
